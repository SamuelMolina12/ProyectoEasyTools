# Configuración del Entorno (Ejemplo)
# Cópialo y renómbralo a .env y ajusta las variables según tu PC.

PROJECT_NAME="EasyTool API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Configuración de Base de Datos SQL Server (Localhost)
# Asegúrate de que el driver coincide con el que tienes instalado (ODBC Driver 17 for SQL Server)
DATABASE_URL="mssql+pyodbc://@localhost/EasyToolDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes"

# JWT Config (Clave secreta para los tokens)
SECRET_KEY="easytool-super-secret-jwt-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS="*"
